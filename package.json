{
  "name": "cookhoard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Cocina de casa para Faustus: recetas (de enlaces, vídeos y texto), despensa con caducidades, tickets, menú, compra, precios y costes.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/mcp",
    "apps/web",
    "packages/core"
  ],
  "scripts": {
    "start": "node server/bootstrap.mjs",
    "dev": "node server/bootstrap.mjs",
    "build": "npm run build --workspace @cookhoard/web",
    "mcp": "npm run start --workspace @cookhoard/mcp",
    "test": "npm run test:core && npm run test:server && npm run test:web && npm run test --workspace @cookhoard/mcp",
    "test:core": "tsx packages/core/test/run.ts && node --import tsx --test packages/core/test/*.test.ts",
    "test:server": "node --import tsx --test server/test/*.test.mjs",
    "docs:api": "node --import tsx scripts/gen-api-docs.mjs",
    "test:web": "node --test apps/web/test/*.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
