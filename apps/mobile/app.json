{
  "expo": {
    "name": "CookHoard",
    "slug": "cookhoard",
    "scheme": "cookhoard",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#12100E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cookhoard"
    },
    "android": {
      "package": "com.cookhoard.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
